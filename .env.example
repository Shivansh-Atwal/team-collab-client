# Where the TeamCollab backend (Express + Socket.IO) runs.
# Leave empty to use same-origin URLs through the Vite dev proxy.
VITE_BACKEND_URL=http://localhost:5000

# Optional TURN relay for video calls across different networks
# VITE_TURN_URL=turn:your-turn-server:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
